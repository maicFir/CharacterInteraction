FROM python:3.12-slim
LABEL io.character-interaction.project="after-rain"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/models/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 curl && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
# Create writable directories before installing dependencies. A later recursive chown
# can copy the entire virtualenv into a second image layer on overlay filesystems.
RUN useradd --uid 10001 --create-home runner && mkdir -p /app /models/piper && chown runner:runner /app /models /models/piper
WORKDIR /app
COPY --chown=runner:runner apps/api/pyproject.toml apps/api/uv.lock ./
USER runner
RUN uv sync --frozen --extra local --no-dev --no-cache
COPY --chown=runner:runner apps/api/app ./app
COPY --chown=runner:runner scripts/prepare_models.py ./prepare_models.py
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s CMD curl --fail http://127.0.0.1:8000/api/health || exit 1
CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--ws-max-size", "16384", "--no-access-log"]
