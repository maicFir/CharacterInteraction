FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/models/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 curl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --extra local --no-dev
COPY apps/api/app ./app
COPY scripts/prepare_models.py ./prepare_models.py
RUN useradd --uid 10001 --create-home runner && mkdir -p /models/piper && chown -R runner:runner /app /models
USER runner
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s CMD curl --fail http://127.0.0.1:8000/api/health || exit 1
CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--ws-max-size", "16384", "--no-access-log"]
