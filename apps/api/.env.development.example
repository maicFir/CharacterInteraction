# Copy to .env.development; the API loads it automatically for local development.
# Same field names as production's GitHub Actions runtime configuration.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STRUCTURED=false

# Free local speech; no API key needed after models are prepared.
STT_PROVIDER=local
WHISPER_MODEL=tiny
WHISPER_DOWNLOAD_ROOT=../../models/huggingface/hub
TTS_PROVIDER=local
# Relative paths are resolved against apps/api even when launched at repo root.
PIPER_MODEL=../../models/piper/zh_CN-huayan-medium.onnx
TURN_TIMEOUT=90
SESSION_TTL=1800
MAX_SESSIONS=100
MAX_MODEL_JOBS=2

# External speech is optional. Configure the endpoint before enabling a provider.
# STT_PROVIDER=compatible
# STT_BASE_URL=https://your-speech-service.example/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
# TTS_PROVIDER=compatible
# TTS_BASE_URL=https://your-speech-service.example/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
