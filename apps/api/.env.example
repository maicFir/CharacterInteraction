ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Enable only for a model that supports strict JSON schema.
OPENROUTER_STRUCTURED=false
STT_PROVIDER=local
WHISPER_MODEL=tiny
TTS_PROVIDER=local
PIPER_MODEL=../../models/piper/zh_CN-huayan-medium.onnx
TURN_TIMEOUT=90

# Optional compatible STT/TTS endpoints. Base URLs include /v1 when required.
# STT_PROVIDER=compatible
# STT_BASE_URL=https://your-speech-service.example/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
# TTS_PROVIDER=compatible
# TTS_BASE_URL=https://your-speech-service.example/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# Optional compatible or local Ollama text service:
# LLM_PROVIDER=compatible
# LLM_BASE_URL=https://your-service.example/v1
# LLM_API_KEY=
# LLM_MODEL=your-model
